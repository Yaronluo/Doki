# Hub 配置契约。将本文件复制到 .env 后在本机填写；.env 不进入版本控制。
# 空凭据会让对应能力返回 notConfigured，不得用默认值或参考项目凭据代替。

# Hub 与数据库；域名仅为示例，需 LAN/VPN 均可解析和访问。
NODE_ENV=development
HUB_HOST=127.0.0.1
HUB_PORT=8080
HUB_BASE_URL=https://hub.example.com
DATABASE_URL=
REDIS_URL=

# 远程所有者登记/恢复凭证（至少 32 字符）；空值仅允许 Hub 本机浏览器登记。
HUB_SETUP_SECRET=

# 分别生成并安全保存；具体编码/长度由首次实现的配置 schema 校验。
CREDENTIAL_ENCRYPTION_KEY=
STREAM_SIGNING_KEY=

# 可选 OAuth 后续方案；当前邮箱/密码/验证码登录无需下面三项，全部留空。
BGM_CLIENT_ID=
BGM_CLIENT_SECRET=
BGM_REDIRECT_URI=
# 示例回调（与 ID/Secret 三项一起填写）：https://hub.example.com/v1/auth/bgm/callback

# 可选补图搜索/手动修正；公开对应表命中的横幅/Logo 无需 token。
TMDB_READ_ACCESS_TOKEN=

# 弹弹play开放弹幕网络：需自行申请，禁止借用参考项目凭据。
DANDANPLAY_APP_ID=
DANDANPLAY_APP_SECRET=

# 空凭据时依赖处于 notConfigured，不能伪装成“无数据”。

# 仅本机/CI 的透明代理环境（公网域名解析到 198.18.0.0/15）需要显式设为 1。
# 普通 LAN/生产必须保持 0；这不是凭据，也不能放宽其他私网/loopback 检查。
OUTBOUND_ALLOW_BENCHMARK_NETWORK=0
